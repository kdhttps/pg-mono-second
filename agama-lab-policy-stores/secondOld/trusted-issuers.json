{
    "Jans::Access_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "configuration": "https://jans-ui.jans.io/.well-known/openid-configuration"
        },
        "token_id": "jti",
        "required_claims": [
            "jti",
            "iss",
            "aud",
            "sub",
            "exp",
            "nbf"
        ]
    },
    "Jans::id_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "configuration": "https://jans-ui.jans.io/.well-known/openid-configuration"
        },
        "token_id": "jti",
        "required_claims": [
            "iat",
            "aud"
        ]
    }
}