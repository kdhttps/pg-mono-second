{
    "Acme::Access_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "jwks": "https://jans.io/jwks",
            "iss": "https://jans.io"
        },
        "token_id": "iss",
        "required_claims": [
            "iss",
            "sub",
            "iat"
        ]
    },
    "Acme::id_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "jwks": "https://jans.io/jans",
            "iss": "https://jans.io"
        },
        "token_id": "iss",
        "required_claims": [
            "iss",
            "sub"
        ]
    },
    "Acme::Userinfo_token": {
        "type": "jwt",
        "issuer": "Acme",
        "configuration_endpoints": {
            "configuration": "https://jans-ui.jans.io/.well-known/openid-configuration"
        },
        "token_id": "jti",
        "required_claims": [
            "jti",
            "iss",
            "sub"
        ]
    }
}